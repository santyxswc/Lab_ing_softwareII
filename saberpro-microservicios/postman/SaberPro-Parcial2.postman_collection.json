          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('REJECTED', () => pm.expect(pm.response.json().outcome).to.eql('REJECTED'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Espera a que Lifecycle Service procese el mensaje asíncrono",
                  "setTimeout(() => {}, 1500);"
                ]
              }
            }
          ]
        },
