# Configuracion de Doxygen para el Laboratorio de Ingenieria de Software II
# Generar la documentacion:  doxygen   (resultado en docs/html/index.html)

PROJECT_NAME           = "Laboratorio de Ingeniería de Software II"
PROJECT_BRIEF          = "API REST de productos (Spring Boot) y banco de preguntas (Microkernel + Pipes & Filters)"
OUTPUT_DIRECTORY       = docs
OUTPUT_LANGUAGE        = Spanish
INPUT                  = README.md APIREST_con_spirngBoot banco-preguntas-microkernel
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.java *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */target/* */.mvn/*
USE_MDFILE_AS_MAINPAGE = README.md
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .

OPTIMIZE_OUTPUT_JAVA   = YES
JAVADOC_AUTOBRIEF      = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
SOURCE_BROWSER         = YES
MARKDOWN_SUPPORT       = YES

GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = docs/doxygen-advertencias.log
